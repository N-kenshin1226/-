  "stroll": {
    "town": [
      {
        "weight": 4,
        "text": "――露店の裏で貨幣を拾った。",
        "money": 4
      },
      {
        "weight": 3,
        "text": "――迷子の犬についていくと、軒先の植え込みに薬草が生えていた。",
        "items": {
          "herb": 1
        }
      },
      {
        "weight": 3,
        "text": "――マルタと行き違い、立ち話に付き合った。",
        "npc": "npc.marta",
        "bond": 5
      },
      {
        "weight": 3,
        "text": "――ノラの露店を眺めていたら、目利きの手ほどきを受けた。",
        "npc": "npc.nola",
        "bond": 4,
        "gain": {
          "skill": "merchant_eye",
          "amount": 1
        }
      },
      {
        "weight": 2,
        "text": "――エーデルと坂道ですれ違った。静かな挨拶を交わした。",
        "npc": "npc.edel",
        "bond": 4
      },
      {
        "weight": 3,
        "text": "――石段で足を滑らせた。小さな擦り傷。",
        "fatigue": 4
      },
      {
        "weight": 3,
        "text": "――行商人に値切りの極意を聞いた。",
        "gain": {
          "skill": "bargaining",
          "amount": 1.5
        }
      },
      {
        "weight": 2,
        "text": "――井戸端の洗い場に落ちていた木の実を拾った。",
        "items": {
          "nut": 1
        }
      },
      {
        "weight": 2,
        "text": "――壁の落書きの陰に、古い記録の切れ端を見つけた。",
        "atom": "rumor.storyteller"
      },
      {
        "weight": 5,
        "text": "――何事もない。ただ風が吹いていた。"
      },
      {
        "weight": 2,
        "text": "――宿屋の裏で、老婆が火に向かいながら昔話をしていた。",
        "atom": "rumor.horde_granny"
      },
      {
        "weight": 2,
        "text": "――礼拝堂の裏で、板で塞がれた古い井戸を見つけた。",
        "atom": "rumor.fever_chapel"
      }
    ],
    "region": [
      {
        "weight": 3,
        "text": "――獣道で木の実を拾った。",
        "items": {
          "nut": 1
        }
      },
      {
        "weight": 3,
        "text": "――見慣れない花を見つけた。薬になるかもしれない。",
        "items": {
          "herb.wild": 1
        }
      },
      {
        "weight": 2,
        "text": "――猟師ガロとすれ違った。獲物の気配を教えてもらった。",
        "npc": "npc.garo",
        "bond": 4
      },
      {
        "weight": 2,
        "text": "――旅人フェンと草むらで言葉を交わした。",
        "npc": "npc.fenn",
        "bond": 4
      },
      {
        "weight": 2,
        "text": "――古い標石に読みかけの文字を見つけた。",
        "gain": {
          "skill": "geography",
          "amount": 2
        }
      },
      {
        "weight": 3,
        "text": "――棘に腕を引っかけた。小さな傷。",
        "fatigue": 4
      },
      {
        "weight": 3,
        "text": "――落ちていた財布を番小屋に届けた。礼を受けた。",
        "money": 8
      },
      {
        "weight": 2,
        "text": "――土の匂いを嗅いだ。雨の気配が分かるようになってきた。",
        "gain": {
          "skill": "observation",
          "amount": 2
        }
      },
      {
        "weight": 5,
        "text": "――静かな一日。遠くで鳥が鳴いていた。"
      },
      {
        "weight": 2,
        "text": "――山道の途中の岩に、見たことのない大きな爪痕があった。",
        "atom": "rumor.beast_claw"
      },
      {
        "weight": 2,
        "text": "――崖の風穴で、風に乗る古い唄を耳にした。",
        "atom": "rumor.beast_ballad"
      }
    ],
    "road": [
      {
        "weight": 3,
        "text": "――街道を行く商隊と行き交った。値段の噂を聞いた。",
        "gain": {
          "skill": "merchant_eye",
          "amount": 1.5
        }
      },
      {
        "weight": 3,
        "text": "――路傍に野の香草が群生していた。",
        "items": {
          "herb.wild": 1
        }
      },
      {
        "weight": 2,
        "text": "――雨宿りで旅人と話した。行き先の地理を聞き出した。",
        "gain": {
          "skill": "geography",
          "amount": 2
        }
      },
      {
        "weight": 3,
        "text": "――足が棒になった。野営の準備に手間取った。",
        "fatigue": 6
      },
      {
        "weight": 2,
        "text": "――荷車の陰で貨幣を拾った。",
        "money": 5
      },
      {
        "weight": 2,
        "text": "――草の匂いを摘んで噛んだ。野の香草が手に入った。",
        "items": {
          "herb.wild": 1
        },
        "fatigue": -4
      },
      {
        "weight": 5,
        "text": "――何事もなく日が暮れた。"
      },
      {
        "weight": 2,
        "text": "――街道沿いの古い倉庫に、黄ばんだ名簿が残っていた。",
        "atom": "rumor.horde_muster"
      },
      {
        "weight": 2,
        "text": "――荷車を止めた行商人が、道端で昔話を聞かせてくれた。",
        "atom": "rumor.fever_cart"
      }
    ]
  },
